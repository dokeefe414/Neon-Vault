{
  "name": "neon-vault",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "A modular virtual-credit casino and progression game built with vanilla HTML, CSS, and JavaScript.",
  "scripts": {
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node tests/smoke.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:all": "npm run check && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
